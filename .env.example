# ─── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_DIR=./logs

# Default runtime: Base/Ethereum/Robinhood legacy radar and paper evaluation.
# `npm run start:sniper` overrides these internally for its isolated BSC experiment.
STRATEGY_MODE=legacy_contract_radar
LAUNCH_SNIPER_MODE=paper
LAUNCH_SNIPER_ENABLED=false
COLLECTOR_AUTOSTART=true
PAPER_EVAL_AUTOSTART=true
GEM_SHADOW_AUTOSTART=true

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://gemradar:gemradar_secret@localhost:5432/gem_radar
POSTGRES_USER=gemradar
POSTGRES_PASSWORD=gemradar_secret
POSTGRES_DB=gem_radar

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── On-chain RPC (Alchemy / Infura / public fallback) ─────────────────────────
ETHEREUM_RPC_URL=https://eth.llamarpc.com
BASE_RPC_URL=https://mainnet.base.org
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_RPC_URL_FALLBACK=
# Leave false until the configured Robinhood RPC supports historical eth_getCode.
ROBINHOOD_HISTORICAL_CODE_ENABLED=false
QUOTER_V2_ROBINHOOD=0x33e885ed0ec9bf04ecfb19341582aadcb4c8a9e7
V4_POOL_MANAGER_ETHEREUM=0x000000000004444c5dc75cB358380D2e3dE08A90
V4_POOL_MANAGER_BASE=0x498581ff718922c3f8e6a244956af099b2652b2b
V4_POOL_MANAGER_ROBINHOOD=0x8366a39cc670b4001a1121b8f6a443a643e40951
V4_QUOTER_ETHEREUM=0x52f0e24d1c21c8a0cb1e5a5dd6198556bd9e1203
V4_QUOTER_BASE=0x0d5e0f971ed27fbff6c2837bf31316121532048d
V4_QUOTER_ROBINHOOD=0x8dc178efb8111bb0973dd9d722ebeff267c98f94
V4_STATE_VIEW_ETHEREUM=0x7ffe42c4a5deea5b0fec41c94c136cf115597227
V4_STATE_VIEW_BASE=0xa3c0c9b65bad0b08107aa264b0f3db444b867a71
V4_STATE_VIEW_ROBINHOOD=0xf3334192d15450cdd385c8b70e03f9a6bd9e673b

# Public fallback supports eth_getLogs in 25-block chunks; override for dedicated limits.
BSC_RPC_URL=https://bsc.blockrazor.xyz
FOUR_MEME_API_BASE_URL=https://four.meme/meme-api/v1
FOUR_MEME_TOKEN_MANAGER=0x5c952063c7fc8610ffdb798152d69f0b9550762b
LAUNCH_SNIPER_POLL_INTERVAL_MS=3000
LAUNCH_SNIPER_INITIAL_LOOKBACK_BLOCKS=300
LAUNCH_SNIPER_MAX_LOG_RANGE_BLOCKS=25
LAUNCH_SNIPER_RPC_REQUEST_DELAY_MS=500
LAUNCH_SNIPER_RPC_TIMEOUT_MS=15000
LAUNCH_SNIPER_API_SEED_ENABLED=true
LAUNCH_SNIPER_API_SEED_INTERVAL_MS=15000
LAUNCH_SNIPER_API_SEED_PAGE_SIZE=30
LAUNCH_SNIPER_POLL_ERROR_BACKOFF_MS=10000
LAUNCH_SNIPER_RATE_LIMIT_BACKOFF_MS=60000
LAUNCH_SNIPER_MAX_BACKOFF_MS=300000
LAUNCH_SNIPER_HEARTBEAT_INTERVAL_MS=30000
LAUNCH_SNIPER_MIN_BLOCKS_AFTER_LAUNCH=6
LAUNCH_SNIPER_POSITION_BNB=0.02
LAUNCH_SNIPER_MIN_BUYS=3
LAUNCH_SNIPER_MIN_UNIQUE_BUYERS=3
LAUNCH_SNIPER_MIN_BUY_BNB=0.10
LAUNCH_SNIPER_MIN_BUY_SELL_RATIO=2
LAUNCH_SNIPER_MAX_BUYER_SHARE=0.65
LAUNCH_SNIPER_MIN_PRICE_MOMENTUM=1.02
LAUNCH_SNIPER_STOP_MULTIPLE=0.80
LAUNCH_SNIPER_TIME_EXIT_MS=3600000

# ─── External APIs ─────────────────────────────────────────────────────────────
DEXSCREENER_BASE_URL=https://api.dexscreener.com
GECKOTERMINAL_BASE_URL=https://api.geckoterminal.com/api/v2
MORALIS_BASE_URL=https://deep-index.moralis.io/api/v2.2
MORALIS_API_KEY=
MORALIS_TRENDING_LIMIT=50
MORALIS_AUTH_BACKOFF_MS=3600000
BIRDEYE_BASE_URL=https://public-api.birdeye.so
BIRDEYE_API_KEY=
BIRDEYE_TOKENLIST_LIMIT=50
GOPLUS_BASE_URL=https://api.gopluslabs.io
# GoPlus free app credentials. GOPLUS_API_KEY is used as GOPLUS_APP_KEY fallback.
GOPLUS_API_KEY=
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=
GOPLUS_CIRCUIT_BREAKER_MS=60000

# Etherscan V2 unified API. The same key can be used for Ethereum and Base.
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=

# ─── Collector ─────────────────────────────────────────────────────────────────
# Chains to monitor - comma-separated, supported: ethereum,base,robinhood
COLLECTOR_CHAINS=ethereum,base,robinhood
# Optional manual probes from DexScreener/gainers, comma-separated chain:token.
# Example: ethereum:0x0000000000000000000000000000000000000000,base:0x0000000000000000000000000000000000000000
MANUAL_PROBE_TOKENS=
# Optional emergency hard block for known repeat deployers, comma-separated chain:address.
# Normal persistent blocklist: npm run deployers:block -- <chain> <address> "reason"
BLOCKED_DEPLOYERS=
# How often to poll external APIs (milliseconds)
COLLECTOR_POLL_INTERVAL_MS=30000
# Ignore pools older than this many hours. 24h keeps late but still-moving meme pools in sample.
NEW_POOL_MAX_AGE_HOURS=24
# Older pools with fresh activity remain eligible for on-chain inspection.
MATURE_MOMENTUM_MIN_VOL_1H_USD=1000
MATURE_MOMENTUM_MIN_TX_1H=20
MATURE_MOMENTUM_MIN_BUYS_1H=10
MATURE_MOMENTUM_MIN_LIQUIDITY_USD=1000
# GeckoTerminal pages to scan for new/trending pools per chain. Keep low to avoid IP rate limits.
GECKOTERMINAL_PAGES=1
# Global pacing between GeckoTerminal requests to avoid 429s.
GECKOTERMINAL_REQUEST_DELAY_MS=7000
# Stop all GeckoTerminal calls for this long after a 429.
GECKOTERMINAL_RATE_LIMIT_BACKOFF_MS=300000
# Cache per-pool trade stats used by paper/gem eval.
GECKOTERMINAL_STATS_CACHE_TTL_MS=600000
# Direct factory-log discovery is not subject to GeckoTerminal/DexScreener listing lag.
# It only admits a factory pool after an on-chain liquidity verification succeeds.
FACTORY_DISCOVERY_ENABLED=true
FACTORY_DISCOVERY_INITIAL_LOOKBACK_ETHEREUM=30
FACTORY_DISCOVERY_INITIAL_LOOKBACK_BASE=120
FACTORY_DISCOVERY_PENDING_TTL_MS=1800000
FACTORY_DISCOVERY_MIN_EXECUTABLE_DEPTH_USD=100
# Token age is used for scoring. Keep this false to allow old/community-vetted
# contracts that relaunch into a fresh pool to pass risk + liquidity checks.
TOKEN_AGE_HARD_GATE_ENABLED=false
TOKEN_MAX_AGE_DAYS=7
# Promote clean partials into a separate paper-only research cohort. They are
# excluded from primary edge until forward data proves the provider gap harmless.
PROMOTE_CLEAN_UNKNOWN_ENABLED=true
# Robinhood primary paper lane. GoPlus/Honeypot are unavailable there, so admission
# requires verified executable liquidity plus static bytecode safety checks.
ROBINHOOD_PAPER_ENABLED=true
ROBINHOOD_MIN_DEPTH_USD=100
ROBINHOOD_MIN_ONCHAIN_TVL_USD=200
ROBINHOOD_MIN_SCORE=50
DEPLOYER_GATE_MIN_DEPLOYMENTS=1
DEPLOYER_GATE_MIN_RUG_LIKE=1
# Paper-only forward cohort for clean, mintable contracts. Excluded from primary edge.
CONTRACT_RISK_SHADOW_ENABLED=true
CONTRACT_RISK_SHADOW_MIN_DEPTH_USD=100
DEPLOYER_GATE_MIN_RUG_RATE=0.5

# ─── Stage 0 Gate ──────────────────────────────────────────────────────────────
# Minimum on-chain (reported) liquidity in USD to pass Stage 0
MIN_LIQUIDITY_USD=5000
# FDV bounds for Stage 0
MIN_FDV_USD=10000
MAX_FDV_USD=50000000

# ─── Scoring & Decisions ───────────────────────────────────────────────────────
PAPER_TRADE_SIZE_USD=20
# Explicit paper position size used by M5. The legacy variable above is only a fallback.
PAPER_POSITION_SIZE_USD=20
# Paper entry should model immediate action once a token survives candidate gates.
PAPER_DETECTION_DELAY_SEC=0
# Optional Base/Ethereum survival experiment. When enabled, it creates a separate
# delayed-entry cohort; keep it disabled for the primary discovery-time paper lane.
PAPER_TAKE_COHORT_ENABLED=false
PAPER_TAKE_COHORT_CHAINS=ethereum,base
PAPER_TAKE_CONFIRMATION_DELAY_SEC=600
PAPER_TAKE_MIN_PRICE_MULTIPLE=1.00
PAPER_TAKE_MIN_EXECUTABLE_DEPTH_USD=100
PAPER_TAKE_MIN_LIQUIDITY_RETENTION=0.80
PAPER_TAKE_MIN_V2_ONCHAIN_TVL_USD=5000
PAPER_SURVIVAL_OBSERVATION_ENABLED=true
PAPER_SURVIVAL_OBSERVATION_DELAY_SEC=600
PAPER_EVAL_INTERVAL_MS=30000
PAPER_EVAL_INITIAL_DELAY_MS=30000
PAPER_EVAL_YOUNG_WINDOW_SEC=3600
PAPER_EVAL_YOUNG_INTERVAL_MS=30000
PAPER_EVAL_MATURE_INTERVAL_MS=300000
# Research-only. Keep disabled so paper evaluation cannot consume the
# GeckoTerminal budget needed for new-pool discovery.
PAPER_COLLECT_TRADE_STATS=false
PAPER_PRICE_READ_FAILURE_RUG_THRESHOLD=3
# ETH/Base retain immediate low-liquidity closes. Robinhood gets a second read
# because its young pools/RPC have shown transient zero-liquidity snapshots.
PAPER_RUG_LIQUIDITY_CONFIRMATIONS=1
ROBINHOOD_PAPER_RUG_LIQUIDITY_CONFIRMATIONS=2
# Auto-evaluate OPEN paper positions so position_ticks/paper_exits keep moving.
# Keep false in launch_sniper_paper; set true only with legacy_contract_radar.
# 0 = evaluate all open positions. Set a positive cap only when API limits force it.
PAPER_EVAL_MAX_OPEN_POSITIONS=0
GEM_AUTOSCREEN_ENABLED=true
GEM_SHADOW_INTERVAL_MS=300000
GEM_SHADOW_INITIAL_DELAY_MS=180000
# Minimum finalGemScore to enter watchlist
WATCHLIST_SCORE_THRESHOLD=60
# Minimum finalGemScore to open a paper trade
PAPER_TRADE_SCORE_THRESHOLD=75

# ─── Telegram Alerts (optional) ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false
TELEGRAM_MIN_SCORE=75
