# ─── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_DIR=./logs

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://gemradar:gemradar_secret@localhost:5432/gem_radar
POSTGRES_USER=gemradar
POSTGRES_PASSWORD=gemradar_secret
POSTGRES_DB=gem_radar

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── On-chain RPC (Alchemy / Infura / public fallback) ─────────────────────────
ETHEREUM_RPC_URL=https://eth.llamarpc.com
BASE_RPC_URL=https://mainnet.base.org

# ─── External APIs ─────────────────────────────────────────────────────────────
DEXSCREENER_BASE_URL=https://api.dexscreener.com
GECKOTERMINAL_BASE_URL=https://api.geckoterminal.com/api/v2
GOPLUS_BASE_URL=https://api.gopluslabs.io
GOPLUS_API_KEY=

# Etherscan V2 unified API. The same key can be used for Ethereum and Base.
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=

# ─── Collector ─────────────────────────────────────────────────────────────────
# Chains to monitor — comma-separated, supported: ethereum,base
COLLECTOR_CHAINS=ethereum,base
# How often to poll external APIs (milliseconds)
COLLECTOR_POLL_INTERVAL_MS=120000
# Ignore pools older than this many hours (avoids re-processing old history)
NEW_POOL_MAX_AGE_HOURS=6

# ─── Stage 0 Gate ──────────────────────────────────────────────────────────────
# Minimum on-chain (reported) liquidity in USD to pass Stage 0
MIN_LIQUIDITY_USD=5000
# FDV bounds for Stage 0
MIN_FDV_USD=10000
MAX_FDV_USD=50000000

# ─── Scoring & Decisions ───────────────────────────────────────────────────────
PAPER_TRADE_SIZE_USD=200
# Minimum finalGemScore to enter watchlist
WATCHLIST_SCORE_THRESHOLD=60
# Minimum finalGemScore to open a paper trade
PAPER_TRADE_SCORE_THRESHOLD=75

# ─── Telegram Alerts (optional) ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false
TELEGRAM_MIN_SCORE=75
