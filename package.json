{
  "name": "gem-radar",
  "version": "0.1.0",
  "description": "Ethereum/Robinhood/Solana Gem Radar - Research & Paper Trading System",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main",
    "start:sniper": "ts-node src/sniper-main.ts",
    "start:sniper:prod": "node dist/src/sniper-main.js",
    "start:solana": "ts-node src/solana-main.ts",
    "start:solana:prod": "node dist/src/solana-main.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "lint": "eslint \"{src}/**/*.ts\" --fix",
    "smoke:goplus": "node scripts/goplus-smoke.js",
    "smoke:risk": "ts-node scripts/smoke-risk.ts",
    "backfill:speculative": "node scripts/backfill-speculative-candidates.js",
    "report:now": "ts-node scripts/report-now.ts",
    "eval": "ts-node scripts/eval.ts",
    "postmortem": "ts-node scripts/postmortem.ts",
    "edge": "ts-node scripts/edge.ts",
    "benchmark": "ts-node scripts/benchmark.ts",
    "benchmark:csv": "ts-node scripts/benchmark-csv.ts",
    "benchmark:flow": "ts-node scripts/flow-benchmark.ts",
    "benchmark:robinhood-entry": "ts-node scripts/robinhood-experiment-benchmark.ts",
    "benchmark:solana-v2": "ts-node scripts/solana-v2-benchmark.ts",
    "sniper:report": "ts-node scripts/sniper-report.ts",
    "deployers:refresh": "ts-node scripts/deployer-reputation.ts",
    "deployers:block": "ts-node scripts/block-deployer.ts",
    "gem:screen": "ts-node scripts/gem-screen.ts",
    "gem:shadow": "ts-node scripts/gem-shadow.ts",
    "gem:report": "ts-node scripts/gem-report.ts",
    "probe:onchain": "ts-node scripts/probe-onchain.ts",
    "probe:factories": "ts-node scripts/probe-factory-discovery.ts",
    "probe:factory-liquidity": "ts-node scripts/probe-factory-discovery.ts --verify",
    "probe:v3": "ts-node scripts/probe-v3.ts",
    "probe:v4": "ts-node scripts/probe-v4.ts",
    "verify:pools": "ts-node scripts/verify-pools.ts",
    "probe:age": "ts-node scripts/probe-age.ts",
    "reset": "ts-node scripts/reset.ts",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "dependencies": {
    "@meteora-ag/cp-amm-sdk": "^1.4.5",
    "@meteora-ag/dynamic-amm-sdk": "^1.4.1",
    "@meteora-ag/dynamic-bonding-curve-sdk": "^1.5.10",
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/schedule": "^4.1.1",
    "@prisma/client": "^5.19.1",
    "@pump-fun/pump-sdk": "^1.36.0",
    "@pump-fun/pump-swap-sdk": "^1.19.0",
    "@raydium-io/raydium-sdk-v2": "^0.2.59-alpha",
    "@solana/web3.js": "^1.98.4",
    "axios": "^1.7.7",
    "axios-retry": "^4.5.0",
    "bn.js": "^5.2.2",
    "bs58": "^5.0.0",
    "bullmq": "^5.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "viem": "^2.21.11",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.4",
    "@types/bn.js": "^5.2.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.16.11",
    "@types/ws": "^8.18.1",
    "jest": "^29.7.0",
    "prisma": "^5.19.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "diagnostics": {
            "ignoreCodes": [
              151002
            ]
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(uuid|rpc-websockets)/)"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.spec.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
