generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Tokens ────────────────────────────────────────────────────────────────────
model Token {
  id              String   @id @default(cuid())
  chain           String
  tokenAddress    String   @map("token_address")
  symbol          String?
  name            String?
  decimals        Int?
  firstSeenAt     DateTime @map("first_seen_at")
  deployerAddress String?  @map("deployer_address")
  source          String // dexscreener | geckoterminal | onchain
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  pools              Pool[]
  poolSnapshots      PoolSnapshot[]
  contractRiskChecks ContractRiskCheck[] @relation("TokenRiskChecks")
  holderSnapshots    HolderSnapshot[]
  scoringHistory     ScoringHistory[]
  paperPositions     PaperPosition[]

  @@unique([chain, tokenAddress])
  @@index([chain])
  @@map("tokens")
}

// ─── Pools ─────────────────────────────────────────────────────────────────────
model Pool {
  id          String   @id @default(cuid())
  chain       String
  poolAddress String   @map("pool_address")
  dex         String
  tokenId     String   @map("token_id")
  token0      String   @map("token0")
  token1      String   @map("token1")
  quoteAsset  String   @map("quote_asset") // WETH | USDC | USDT | DAI
  feeTier     String?  @map("fee_tier")
  v4Metadata  Json?    @map("v4_metadata") // immutable PoolKey captured from Initialize
  firstSeenAt DateTime @map("first_seen_at")
  createdAt   DateTime @default(now()) @map("created_at")

  token          Token           @relation(fields: [tokenId], references: [id])
  poolSnapshots  PoolSnapshot[]
  paperPositions PaperPosition[]

  @@unique([chain, poolAddress])
  @@index([chain])
  @@map("pools")
}

// ─── Pool Snapshots (append-only, never updated) ───────────────────────────────
model PoolSnapshot {
  id                   String   @id @default(cuid())
  chain                String
  poolId               String   @map("pool_id")
  tokenId              String   @map("token_id")
  ts                   DateTime
  priceUsd             Decimal? @map("price_usd") @db.Decimal(30, 18)
  reserveToken         Decimal? @map("reserve_token") @db.Decimal(40, 0)
  reserveQuote         Decimal? @map("reserve_quote") @db.Decimal(40, 0)
  onchainLiquidityUsd  Decimal? @map("onchain_liquidity_usd") @db.Decimal(20, 4)
  reportedLiquidityUsd Decimal? @map("reported_liquidity_usd") @db.Decimal(20, 4)
  fdvUsd               Decimal? @map("fdv_usd") @db.Decimal(20, 4)
  vol5m                Decimal? @map("vol_5m") @db.Decimal(20, 4)
  vol1h                Decimal? @map("vol_1h") @db.Decimal(20, 4)
  vol6h                Decimal? @map("vol_6h") @db.Decimal(20, 4)
  vol24h               Decimal? @map("vol_24h") @db.Decimal(20, 4)
  txCount              Int?     @map("tx_count")
  buys                 Int?
  sells                Int?
  uniqueBuyers         Int?     @map("unique_buyers")
  uniqueSellers        Int?     @map("unique_sellers")
  holdersCount         Int?     @map("holders_count")
  executableDepthUsd   Decimal? @map("executable_depth_usd") @db.Decimal(20, 4)
  slip50               Decimal? @map("slip_50") @db.Decimal(10, 6)
  slip100              Decimal? @map("slip_100") @db.Decimal(10, 6)
  slip500              Decimal? @map("slip_500") @db.Decimal(10, 6)
  slip1000             Decimal? @map("slip_1000") @db.Decimal(10, 6)
  // M3A on-chain liquidity fields
  liquidityModel       String?  @map("liquidity_model") // V2 | V3 | UNSUPPORTED_*
  liquidityVerified    Boolean? @map("liquidity_verified")
  reportedVsOnchainPct Decimal? @map("reported_vs_onchain_pct") @db.Decimal(10, 4)
  spotPriceUsd         Decimal? @map("spot_price_usd") @db.Decimal(30, 18)
  createdAt            DateTime @default(now()) @map("created_at")

  pool  Pool  @relation(fields: [poolId], references: [id])
  token Token @relation(fields: [tokenId], references: [id])

  @@index([chain, poolId, ts])
  @@index([ts])
  @@map("pool_snapshots")
}

// ─── Deployers ─────────────────────────────────────────────────────────────────
model Deployer {
  id               String   @id @default(cuid())
  chain            String
  address          String
  funderAddress    String?  @map("funder_address")
  deploymentsCount Int      @default(0) @map("deployments_count")
  rugLikeCount     Int      @default(0) @map("rug_like_count")
  riskScore        Decimal? @map("risk_score") @db.Decimal(5, 2)
  summary          String?
  updatedAt        DateTime @updatedAt @map("updated_at")
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([chain, address])
  @@map("deployers")
}

// ─── Contract Risk Checks (M2A) ────────────────────────────────────────────────
// Written for ALL decisions: CONTRACT_SAFE, CONTRACT_REJECT, CONTRACT_UNKNOWN.
// tokenId is null for REJECT/UNKNOWN (no DB token row exists yet).
model ContractRiskCheck {
  id               String   @id @default(cuid())
  runId            String?  @map("run_id")
  chain            String
  tokenAddress     String   @map("token_address")
  tokenId          String?  @map("token_id")
  ts               DateTime
  source           String   @default("goplus")
  goplusQueried    Boolean  @default(false) @map("goplus_queried")
  honeypotQueried  Boolean  @default(false) @map("honeypot_queried")
  verified         Boolean?
  honeypot         Boolean?
  buyTax           Decimal? @map("buy_tax") @db.Decimal(10, 4)
  sellTax          Decimal? @map("sell_tax") @db.Decimal(10, 4)
  canMint          Boolean? @map("can_mint")
  canBlacklist     Boolean? @map("can_blacklist")
  canPause         Boolean? @map("can_pause")
  isProxy          Boolean? @map("is_proxy")
  ownerRenounced   Boolean? @map("owner_renounced")
  lpLockedOrBurned Boolean? @map("lp_locked_or_burned")
  decision         String   @default("CONTRACT_UNKNOWN")
  rejectReasons    Json?    @map("reject_reasons")
  hardReject       Boolean  @default(false) @map("hard_reject")
  rejectReason     String?  @map("reject_reason")
  rawGoplusJson    Json?    @map("raw_goplus_json")
  rawHoneypotJson  Json?    @map("raw_honeypot_json")
  createdAt        DateTime @default(now()) @map("created_at")

  token Token? @relation("TokenRiskChecks", fields: [tokenId], references: [id])

  @@index([chain, tokenAddress, ts])
  @@index([runId])
  @@map("contract_risk_checks")
}

// ─── Quarantine Tokens (M2A) ────────────────────────────────────────────────────
// Tokens where both GoPlus and Honeypot.is were unavailable (CONTRACT_UNKNOWN).
// Not persisted as passed candidates. Retry queue re-checks them.
model QuarantineToken {
  id               String    @id @default(cuid())
  runId            String    @map("run_id")
  chain            String
  tokenAddress     String    @map("token_address")
  tokenSymbol      String?   @map("token_symbol")
  tokenName        String?   @map("token_name")
  poolAddress      String    @map("pool_address")
  dex              String
  status           String    @default("PENDING") // PENDING | RESOLVED | ABANDONED
  retryCount       Int       @default(0) @map("retry_count")
  nextRetryAt      DateTime? @map("next_retry_at")
  resolvedAt       DateTime? @map("resolved_at")
  resolvedDecision String?   @map("resolved_decision") // CONTRACT_SAFE | CONTRACT_REJECT | null
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([chain, tokenAddress])
  @@index([status, nextRetryAt])
  @@map("quarantine_tokens")
}

// ─── Holder Snapshots ──────────────────────────────────────────────────────────
model HolderSnapshot {
  id            String   @id @default(cuid())
  chain         String
  tokenId       String   @map("token_id")
  ts            DateTime
  top1Pct       Decimal? @map("top1_pct") @db.Decimal(8, 4)
  top5Pct       Decimal? @map("top5_pct") @db.Decimal(8, 4)
  top10Pct      Decimal? @map("top10_pct") @db.Decimal(8, 4)
  top20Pct      Decimal? @map("top20_pct") @db.Decimal(8, 4)
  nonlpTop1Pct  Decimal? @map("nonlp_top1_pct") @db.Decimal(8, 4)
  nonlpTop10Pct Decimal? @map("nonlp_top10_pct") @db.Decimal(8, 4)
  clusterMaxPct Decimal? @map("cluster_max_pct") @db.Decimal(8, 4)
  createdAt     DateTime @default(now()) @map("created_at")

  token Token @relation(fields: [tokenId], references: [id])

  @@index([chain, tokenId, ts])
  @@map("holder_snapshots")
}

// ─── Scoring History ───────────────────────────────────────────────────────────
// M4 scoring. Only CONTRACT_SAFE + liquidity_verified=true survivors are scored.
// Component scores are nullable: a component is NULL when its data was absent
// (omitted + weights renormalized) — never a fabricated neutral value.
model ScoringHistory {
  id                String   @id @default(cuid())
  runId             String?  @map("run_id")
  chain             String
  tokenId           String   @map("token_id")
  tokenAddress      String   @map("token_address")
  poolAddress       String?  @map("pool_address")
  ts                DateTime
  liquidityModel    String   @map("liquidity_model") // V2 | V3
  liquidityScore    Decimal? @map("liquidity_score") @db.Decimal(5, 2)
  depthScore        Decimal? @map("depth_score") @db.Decimal(5, 2)
  ageScore          Decimal? @map("age_score") @db.Decimal(5, 2)
  tractionScore     Decimal? @map("traction_score") @db.Decimal(5, 2)
  divergenceScore   Decimal? @map("divergence_score") @db.Decimal(5, 2)
  finalScore        Decimal  @map("final_score") @db.Decimal(5, 2)
  band              String // reject_band | watchlist | candidate | high_band (UNVALIDATED)
  scoreConfidence   Decimal  @map("score_confidence") @db.Decimal(4, 3)
  componentsPresent String   @map("components_present") // comma-joined component keys
  componentsMissing String   @map("components_missing")
  createdAt         DateTime @default(now()) @map("created_at")

  token Token @relation(fields: [tokenId], references: [id])

  @@index([chain, tokenId, ts])
  @@index([finalScore])
  @@index([band])
  @@map("scoring_history")
}

// ─── Paper Positions (M5 — PAPER ONLY, no real trades) ──────────────────────────
// One row per candidate (CONTRACT_SAFE + liquidity_verified=true). Entry is modeled
// once at discovery with pessimistic fills; eval re-reads on-chain state on demand.
model PaperPosition {
  id                       String    @id @default(cuid())
  runId                    String?   @map("run_id")
  chain                    String
  tokenId                  String    @map("token_id")
  poolId                   String    @map("pool_id")
  tokenAddress             String    @map("token_address")
  poolAddress              String    @map("pool_address")
  symbol                   String?
  liquidityModel           String    @map("liquidity_model")
  strategyVersion          String    @default("legacy_static_v0") @map("strategy_version")
  signalId                 String?   @unique @map("signal_id")
  riskCohort               String    @default("CONTRACT_SAFE") @map("risk_cohort")
  exitPolicy               String    @default("SAFE_LADDER") @map("exit_policy")
  benchmarkEligible        Boolean   @default(true) @map("benchmark_eligible")
  // Entry timing (no look-ahead: entry uses a snapshot with ts ≤ openedAt).
  firstSeenAt              DateTime  @map("first_seen_at")
  detectionDelaySec        Int       @map("detection_delay_sec")
  openedAt                 DateTime  @map("opened_at")
  sizeUsd                  Decimal   @map("size_usd") @db.Decimal(12, 4)
  // Entry economics (pessimistic fill).
  entryPriceUsd            Decimal?  @map("entry_price_usd") @db.Decimal(80, 36) // spot at entry
  entryPriceEffectiveUsd   Decimal?  @map("entry_price_effective_usd") @db.Decimal(80, 36) // after all costs
  modeledSlippagePct       Decimal?  @map("modeled_slippage_pct") @db.Decimal(10, 6)
  modeledSandwichPct       Decimal?  @map("modeled_sandwich_pct") @db.Decimal(10, 6)
  modeledGasUsd            Decimal?  @map("modeled_gas_usd") @db.Decimal(12, 4)
  modeledBuyTaxPct         Decimal?  @map("modeled_buy_tax_pct") @db.Decimal(10, 6)
  tokensBought             Decimal?  @map("tokens_bought") @db.Decimal(80, 18)
  onchainLiqEntryUsd       Decimal?  @map("onchain_liq_entry_usd") @db.Decimal(20, 4)
  entryFeatures            Json?     @map("entry_features") // t0 snapshot features for post-mortem
  // Lifecycle.
  status                   String    @default("OPEN") // PENDING_CONFIRMATION | OPEN | CLOSED | INVALIDATED | NOT_ENTERED
  notEnteredReason         String?   @map("not_entered_reason")
  executedRungs            String    @default("") @map("executed_rungs") // comma-joined rung multiples sold
  remainingFraction        Decimal   @default(1) @map("remaining_fraction") @db.Decimal(8, 6)
  realizedValueUsd         Decimal   @default(0) @map("realized_value_usd") @db.Decimal(20, 4)
  // Eval state (refreshed on demand).
  lastEvalAt               DateTime? @map("last_eval_at")
  priceNowUsd              Decimal?  @map("price_now_usd") @db.Decimal(80, 36)
  onchainLiqNowUsd         Decimal?  @map("onchain_liq_now_usd") @db.Decimal(20, 4)
  currentMultiple          Decimal?  @map("current_multiple") @db.Decimal(16, 4)
  maxMultipleObserved      Decimal?  @map("max_multiple_observed") @db.Decimal(16, 4)
  maxDrawdownObserved      Decimal?  @map("max_drawdown_observed") @db.Decimal(10, 4)
  // Last-tick post-t0 rug signals (COLLECTION ONLY — not wired into exits). Captured
  // each eval run; the LAST value before close feeds the post-mortem comparison.
  lastUniqueBuyers         Int?      @map("last_unique_buyers")
  lastUniqueSellers        Int?      @map("last_unique_sellers")
  lastSellersToBuyersRatio Decimal?  @map("last_sellers_to_buyers_ratio") @db.Decimal(12, 4)
  lastSellSimOk            Boolean?  @map("last_sell_sim_ok")
  lastSellTaxNow           Decimal?  @map("last_sell_tax_now") @db.Decimal(10, 6)
  // Close.
  closedAt                 DateTime? @map("closed_at")
  realizedMultiple         Decimal?  @map("realized_multiple") @db.Decimal(16, 4) // total realized value / size
  outcomeClass             String?   @map("outcome_class")
  // WIN | LOSS | RUG | UNSELLABLE | LIQ_PULL | STILL_ACTIVE | NOT_ENTERED
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  token  Token           @relation(fields: [tokenId], references: [id])
  pool   Pool            @relation(fields: [poolId], references: [id])
  events PaperEvent[]
  signal StrategySignal? @relation(fields: [signalId], references: [id])

  @@index([chain, tokenId])
  @@index([chain, strategyVersion, openedAt])
  @@index([status])
  @@index([outcomeClass])
  @@map("paper_positions")
}

// Canonical ETH/Base flow research state. Raw swaps are retained so strategy
// thresholds can be replayed without relying on third-party aggregate fields.
model EvmPoolWatch {
  id                         String   @id @default(cuid())
  chain                      String
  tokenAddress               String   @map("token_address")
  poolAddress                String   @map("pool_address")
  dex                        String
  liquidityModel             String?  @map("liquidity_model")
  watchType                  String   @map("watch_type") // FRESH | MATURE
  source                     String
  status                     String   @default("WATCHING")
  discoveredAt               DateTime @map("discovered_at")
  expiresAt                  DateTime @map("expires_at")
  outcomeDueAt               DateTime @map("outcome_due_at")
  creationBlock              String?  @map("creation_block")
  creationTxHash             String?  @map("creation_tx_hash")
  creationLogIndex           Int?     @map("creation_log_index")
  creatorAddress             String?  @map("creator_address")
  lastProcessedBlock         String?  @map("last_processed_block")
  lastProcessedBlockHash     String?  @map("last_processed_block_hash")
  candidateJson              Json     @map("candidate_json")
  latestFlowSnapshot         Json?    @map("latest_flow_snapshot")
  latestDataHealth           Json?    @map("latest_data_health")
  firstPriceUsd              Decimal? @map("first_price_usd") @db.Decimal(80, 36)
  spotMaxMultiple            Decimal? @map("spot_max_multiple") @db.Decimal(20, 6)
  executableNetMaxMultiple   Decimal? @map("executable_net_max_multiple") @db.Decimal(20, 6)
  benchmarkTokensBought      Decimal? @map("benchmark_tokens_bought") @db.Decimal(80, 18)
  benchmarkEntryEffectiveUsd Decimal? @map("benchmark_entry_effective_usd") @db.Decimal(80, 36)
  benchmarkEntryGasUsd       Decimal? @map("benchmark_entry_gas_usd") @db.Decimal(12, 4)
  timeTo2xSec                Int?     @map("time_to_2x_sec")
  maxDrawdown                Decimal? @map("max_drawdown") @db.Decimal(10, 6)
  outcome15m                 String?  @map("outcome_15m")
  outcome1h                  String?  @map("outcome_1h")
  outcome6h                  String?  @map("outcome_6h")
  outcome24h                 String?  @map("outcome_24h")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  swaps                EvmSwapObservation[]
  signals              StrategySignal[]
  backfills            EvmFlowBackfillRange[]
  robinhoodExperiments RobinhoodEntryExperiment[]

  @@unique([chain, poolAddress, watchType])
  @@index([chain, status, expiresAt])
  @@index([outcomeDueAt])
  @@map("evm_pool_watches")
}

model EvmSwapObservation {
  id             String   @id @default(cuid())
  watchId        String   @map("watch_id")
  chain          String
  poolAddress    String   @map("pool_address")
  blockNumber    String   @map("block_number")
  blockHash      String?  @map("block_hash")
  txHash         String   @map("tx_hash")
  logIndex       Int      @map("log_index")
  ts             DateTime
  trader         String
  kind           String // BUY | SELL
  quoteAmountUsd Decimal  @map("quote_amount_usd") @db.Decimal(30, 8)
  tokenAmount    Decimal? @map("token_amount") @db.Decimal(80, 18)
  priceUsd       Decimal? @map("price_usd") @db.Decimal(80, 36)
  createdAt      DateTime @default(now()) @map("created_at")

  watch EvmPoolWatch @relation(fields: [watchId], references: [id], onDelete: Cascade)

  @@unique([chain, txHash, logIndex])
  @@index([watchId, ts])
  @@map("evm_swap_observations")
}

model StrategySignal {
  id                              String    @id @default(cuid())
  watchId                         String    @map("watch_id")
  strategyVersion                 String    @map("strategy_version")
  chain                           String
  tokenAddress                    String    @map("token_address")
  poolAddress                     String    @map("pool_address")
  observedAt                      DateTime  @map("observed_at")
  firstEligibleAt                 DateTime? @map("first_eligible_at")
  firstEligibleBlock              String?   @map("first_eligible_block")
  firstEligibleFlowSnapshot       Json?     @map("first_eligible_flow_snapshot")
  firstEligibleDataHealthSnapshot Json?     @map("first_eligible_data_health_snapshot")
  latestSwapAt                    DateTime? @map("latest_swap_at")
  observedBlock                   String    @map("observed_block")
  expiresAt                       DateTime  @map("expires_at")
  executablePriceUsd              Decimal?  @map("executable_price_usd") @db.Decimal(80, 36)
  flowSnapshot                    Json      @map("flow_snapshot")
  riskSnapshot                    Json?     @map("risk_snapshot")
  dataHealthSnapshot              Json?     @map("data_health_snapshot")
  entryQuoteSnapshot              Json?     @map("entry_quote_snapshot")
  status                          String    @default("OBSERVED") // OBSERVED | ENTERED | HARD_REJECT | REORG_INVALIDATED
  idempotencyKey                  String    @unique @map("idempotency_key")
  createdAt                       DateTime  @default(now()) @map("created_at")
  updatedAt                       DateTime  @updatedAt @map("updated_at")

  watch         EvmPoolWatch   @relation(fields: [watchId], references: [id], onDelete: Cascade)
  paperPosition PaperPosition?

  @@unique([watchId, strategyVersion])
  @@index([chain, strategyVersion, observedAt])
  @@map("strategy_signals")
}

// Pre-registered Robinhood entry experiment. One row is one independent market
// sample; its arms are counterfactual executions of the same frozen signal.
model RobinhoodEntryExperiment {
  id                             String    @id @default(cuid())
  watchId                        String    @unique @map("watch_id")
  chain                          String    @default("robinhood")
  tokenAddress                   String    @map("token_address")
  poolAddress                    String    @map("pool_address")
  symbol                         String?
  liquidityModel                 String    @map("liquidity_model")
  status                         String    @default("CONFIRMING") // CONFIRMING | CONFIRMED | EXPIRED | RESOLVED | INVALIDATED
  invalidReason                  String?   @map("invalid_reason")
  configVersion                  String    @map("config_version")
  configHash                     String    @map("config_hash")
  configJson                     Json      @map("config_json")
  t0At                           DateTime  @map("t0_at")
  horizonAt                      DateTime  @map("horizon_at")
  t0Block                        String    @map("t0_block")
  t0SpotPriceUsd                 Decimal   @map("t0_spot_price_usd") @db.Decimal(80, 36)
  t0DepthUsd                     Decimal   @map("t0_depth_usd") @db.Decimal(20, 4)
  t0RoundTripMultiple            Decimal   @map("t0_round_trip_multiple") @db.Decimal(16, 6)
  riskSnapshot                   Json      @map("risk_snapshot")
  dataHealthSnapshot             Json      @map("data_health_snapshot")
  v2ShadowDecision               String?   @map("v2_shadow_decision")
  v2ShadowSnapshot               Json?     @map("v2_shadow_snapshot")
  confirmationStatus             String    @default("PENDING") @map("confirmation_status") // PENDING | CONFIRMED | EXPIRED | REJECTED
  confirmationAt                 DateTime? @map("confirmation_at")
  confirmationBlock              String?   @map("confirmation_block")
  confirmationSnapshot           Json?     @map("confirmation_snapshot")
  classifierReferenceStatus      String    @default("PENDING") @map("classifier_reference_status") // PENDING | TRACKING | UNAVAILABLE | RESOLVED
  classifierReferenceTargetAt    DateTime? @map("classifier_reference_target_at")
  classifierReferenceAt          DateTime? @map("classifier_reference_at")
  classifierReferenceTokens      Decimal?  @map("classifier_reference_tokens") @db.Decimal(80, 18)
  classifierReferenceCostUsd     Decimal?  @map("classifier_reference_cost_usd") @db.Decimal(20, 6)
  classifierReferenceMaxMultiple Decimal?  @map("classifier_reference_max_multiple") @db.Decimal(20, 6)
  classifierReached2x            Boolean?  @map("classifier_reached_2x")
  classifierResolvedAt           DateTime? @map("classifier_resolved_at")
  resolvedAt                     DateTime? @map("resolved_at")
  resolutionReason               String?   @map("resolution_reason")
  createdAt                      DateTime  @default(now()) @map("created_at")
  updatedAt                      DateTime  @updatedAt @map("updated_at")

  watch EvmPoolWatch             @relation(fields: [watchId], references: [id], onDelete: Cascade)
  arms  RobinhoodExperimentArm[]

  @@index([status, t0At])
  @@index([tokenAddress, poolAddress])
  @@map("robinhood_entry_experiments")
}

model RobinhoodExperimentArm {
  id                  String    @id @default(cuid())
  experimentId        String    @map("experiment_id")
  armCode             String    @map("arm_code")
  scenarioCode        String    @map("scenario_code")
  latencyMs           Int       @map("latency_ms")
  gasMultiplier       Decimal   @default(1) @map("gas_multiplier") @db.Decimal(8, 4)
  confirmatory        Boolean
  exploratory         Boolean
  primaryScenario     Boolean   @default(false) @map("primary_scenario")
  stressScenario      Boolean   @default(false) @map("stress_scenario")
  immediateUsd        Decimal   @map("immediate_usd") @db.Decimal(12, 4)
  addUsd              Decimal   @map("add_usd") @db.Decimal(12, 4)
  status              String    @default("PENDING_ENTRY") // PENDING_ENTRY | WAITING_CONFIRMATION | OPEN | CLOSED | NO_TRADE | INVALIDATED
  committedUsd        Decimal   @default(0) @map("committed_usd") @db.Decimal(20, 6)
  tokensBought        Decimal   @default(0) @map("tokens_bought") @db.Decimal(80, 18)
  remainingTokens     Decimal   @default(0) @map("remaining_tokens") @db.Decimal(80, 18)
  realizedValueUsd    Decimal   @default(0) @map("realized_value_usd") @db.Decimal(20, 6)
  gasSpentUsd         Decimal   @default(0) @map("gas_spent_usd") @db.Decimal(20, 6)
  blendedCostBasisUsd Decimal?  @map("blended_cost_basis_usd") @db.Decimal(80, 36)
  currentMultiple     Decimal?  @map("current_multiple") @db.Decimal(20, 6)
  peakMultiple        Decimal?  @map("peak_multiple") @db.Decimal(20, 6)
  maxDrawdown         Decimal?  @map("max_drawdown") @db.Decimal(10, 6)
  realizedMultiple    Decimal?  @map("realized_multiple") @db.Decimal(20, 6)
  executedRungs       String    @default("") @map("executed_rungs")
  capitalSeconds      Decimal   @default(0) @map("capital_seconds") @db.Decimal(30, 6)
  openedAt            DateTime? @map("opened_at")
  closedAt            DateTime? @map("closed_at")
  outcomeClass        String?   @map("outcome_class")
  stateJson           Json?     @map("state_json")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  experiment RobinhoodEntryExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  legs       RobinhoodExperimentLeg[]

  @@unique([experimentId, armCode, scenarioCode])
  @@index([status, updatedAt])
  @@index([armCode, scenarioCode, closedAt])
  @@map("robinhood_experiment_arms")
}

model RobinhoodExperimentLeg {
  id                String    @id @default(cuid())
  armId             String    @map("arm_id")
  sequence          Int
  legType           String    @map("leg_type") // IMMEDIATE_BUY | PROBE_BUY | CONFIRM_ADD | LADDER_SELL | STOP_SELL | EXPIRY_SELL | TIME_SELL
  status            String // PENDING | FILLED | FAILED | SKIPPED
  intendedAt        DateTime  @map("intended_at")
  targetAt          DateTime  @map("target_at")
  executedAt        DateTime? @map("executed_at")
  blockNumber       String?   @map("block_number")
  notionalUsd       Decimal   @map("notional_usd") @db.Decimal(20, 6)
  tokenAmount       Decimal?  @map("token_amount") @db.Decimal(80, 18)
  spotPriceUsd      Decimal?  @map("spot_price_usd") @db.Decimal(80, 36)
  effectivePriceUsd Decimal?  @map("effective_price_usd") @db.Decimal(80, 36)
  slippagePct       Decimal?  @map("slippage_pct") @db.Decimal(10, 6)
  gasUsd            Decimal   @default(0) @map("gas_usd") @db.Decimal(20, 6)
  taxPct            Decimal?  @map("tax_pct") @db.Decimal(10, 6)
  netUsd            Decimal?  @map("net_usd") @db.Decimal(20, 6)
  failureReason     String?   @map("failure_reason")
  quoteSnapshot     Json?     @map("quote_snapshot")
  createdAt         DateTime  @default(now()) @map("created_at")

  arm RobinhoodExperimentArm @relation(fields: [armId], references: [id], onDelete: Cascade)

  @@unique([armId, sequence])
  @@index([status, targetAt])
  @@index([armId, executedAt])
  @@map("robinhood_experiment_legs")
}

model EvmFlowBackfillRange {
  id             String    @id @default(cuid())
  watchId        String    @map("watch_id")
  chain          String
  liquidityModel String    @map("liquidity_model")
  fromBlock      String    @map("from_block")
  toBlock        String    @map("to_block")
  status         String    @default("PENDING") // PENDING | RESOLVED
  attempts       Int       @default(1)
  lastError      String?   @map("last_error")
  idempotencyKey String    @unique @map("idempotency_key")
  resolvedAt     DateTime? @map("resolved_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  watch EvmPoolWatch @relation(fields: [watchId], references: [id], onDelete: Cascade)

  @@index([chain, status, updatedAt])
  @@map("evm_flow_backfill_ranges")
}

model EvmRpcHealthSample {
  id               String   @id @default(cuid())
  chain            String
  ts               DateTime @default(now())
  headBlock        String?  @map("head_block")
  cursorBlock      String?  @map("cursor_block")
  lagBlocks        Int      @map("lag_blocks")
  totalShards      Int      @map("total_shards")
  failedShards     Int      @map("failed_shards")
  unresolvedRanges Int      @map("unresolved_ranges")
  coverageRatio    Decimal  @map("coverage_ratio") @db.Decimal(8, 6)
  signalEligible   Boolean  @map("signal_eligible")
  streamMode       String   @map("stream_mode")
  rpcFailures      Int      @map("rpc_failures")

  @@index([chain, ts])
  @@map("evm_rpc_health_samples")
}

// Solana is intentionally isolated from the EVM collector. One row follows a
// Raydium LaunchLab mint from discovery through a complete paper lifecycle.
model SolanaLaunchPosition {
  id                     String    @id @default(cuid())
  strategyVersion        String    @default("solana_raydium_graduation_v1") @map("strategy_version")
  mintAddress            String    @map("mint_address")
  poolAddress            String    @map("pool_address")
  quoteMint              String    @map("quote_mint")
  creatorAddress         String?   @map("creator_address")
  symbol                 String?
  name                   String?
  decimals               Int
  launchedAt             DateTime  @map("launched_at")
  watchExpiresAt         DateTime  @map("watch_expires_at")
  discoveryCohort        String    @default("FORWARD_PRIMARY") @map("discovery_cohort")
  benchmarkEligible      Boolean   @default(true) @map("benchmark_eligible")
  status                 String    @default("WATCHING") // WATCHING | OPEN | CLOSED | REJECTED | EXPIRED
  resolutionReason       String?   @map("resolution_reason")
  latestLaunchSnapshot   Json?     @map("latest_launch_snapshot")
  lastRouteProbeAt       DateTime? @map("last_route_probe_at")
  routeProbeAttempts     Int       @default(0) @map("route_probe_attempts")
  safetySnapshot         Json?     @map("safety_snapshot")
  entryQuoteSnapshot     Json?     @map("entry_quote_snapshot")
  openedAt               DateTime? @map("opened_at")
  sizeUsd                Decimal   @default(20) @map("size_usd") @db.Decimal(12, 4)
  committedUsd           Decimal   @default(0) @map("committed_usd") @db.Decimal(20, 6)
  entryPriceEffectiveUsd Decimal?  @map("entry_price_effective_usd") @db.Decimal(80, 36)
  tokensBoughtRaw        String?   @map("tokens_bought_raw")
  remainingTokensRaw     String?   @map("remaining_tokens_raw")
  realizedValueUsd       Decimal   @default(0) @map("realized_value_usd") @db.Decimal(20, 6)
  currentMultiple        Decimal?  @map("current_multiple") @db.Decimal(20, 6)
  maxMultipleObserved    Decimal?  @map("max_multiple_observed") @db.Decimal(20, 6)
  executedRungs          String    @default("") @map("executed_rungs")
  closedAt               DateTime? @map("closed_at")
  realizedMultiple       Decimal?  @map("realized_multiple") @db.Decimal(20, 6)
  outcomeClass           String?   @map("outcome_class")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  events SolanaPaperEvent[]

  @@unique([strategyVersion, mintAddress])
  @@index([status, launchedAt])
  @@map("solana_launch_positions")
}

model SolanaPaperEvent {
  id             String   @id @default(cuid())
  positionId     String   @map("position_id")
  eventType      String   @map("event_type")
  ts             DateTime
  tokenAmountRaw String?  @map("token_amount_raw")
  grossUsd       Decimal? @map("gross_usd") @db.Decimal(20, 6)
  netUsd         Decimal? @map("net_usd") @db.Decimal(20, 6)
  multiple       Decimal? @db.Decimal(20, 6)
  quoteSnapshot  Json?    @map("quote_snapshot")
  note           String?
  createdAt      DateTime @default(now()) @map("created_at")

  position SolanaLaunchPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@index([positionId, ts])
  @@map("solana_paper_events")
}

// Multi-venue Solana v2 data is canonical in Postgres. The v1 LaunchLab models
// above remain immutable so control results are never rewritten by this experiment.
model SolanaProgramCursor {
  id                    String   @id @default(cuid())
  venue                 String
  programId             String   @unique @map("program_id")
  lastSeenSlot          BigInt?  @map("last_seen_slot")
  lastFinalizedSlot     BigInt?  @map("last_finalized_slot")
  lastBackfillSignature String?  @map("last_backfill_signature")
  streamConnected       Boolean  @default(false) @map("stream_connected")
  unresolvedGap         Boolean  @default(false) @map("unresolved_gap")
  rpcFailures           Int      @default(0) @map("rpc_failures")
  healthSnapshot        Json?    @map("health_snapshot")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@index([venue, updatedAt])
  @@map("solana_program_cursors")
}

model SolanaLaunchWatch {
  id                        String   @id @default(cuid())
  venue                     String
  programId                 String   @map("program_id")
  mintAddress               String   @map("mint_address")
  poolAddress               String   @map("pool_address")
  quoteMint                 String   @map("quote_mint")
  creatorAddress            String?  @map("creator_address")
  symbol                    String?
  name                      String?
  decimals                  Int?
  launchedAt                DateTime @map("launched_at")
  discoverySlot             BigInt   @map("discovery_slot")
  discoverySignature        String   @map("discovery_signature")
  discoveryInstructionIndex Int      @map("discovery_instruction_index")
  // Explicit identities are nullable for pre-v3 records. New observations use
  // these keys to prevent a mint-only match from crossing a migration boundary.
  launchId                  String?  @map("launch_id")
  migrationId               String?  @map("migration_id")
  latestSlot                BigInt   @map("latest_slot")
  latestEventAt             DateTime @map("latest_event_at")
  lastObservedSignature     String?  @map("last_observed_signature")
  unresolvedGap             Boolean  @default(false) @map("unresolved_gap")
  discoveryCohort           String   @map("discovery_cohort")
  benchmarkEligible         Boolean  @default(false) @map("benchmark_eligible")
  status                    String   @default("WATCHING")
  finalized                 Boolean  @default(false)
  invalidatedAt             DateTime? @map("invalidated_at")
  resolutionReason          String?  @map("resolution_reason")
  healthSnapshot            Json?    @map("health_snapshot")
  riskSnapshot              Json?    @map("risk_snapshot")
  quoteSnapshot             Json?    @map("quote_snapshot")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  observations SolanaSwapObservation[]
  signals      SolanaExperimentSignal[]
  poolEras     SolanaPoolEra[]

  @@unique([programId, discoverySignature, discoveryInstructionIndex])
  @@index([venue, mintAddress])
  @@index([status, latestEventAt])
  @@map("solana_launch_watches")
}

model SolanaSwapObservation {
  id               String   @id @default(cuid())
  watchId          String   @map("watch_id")
  poolEraId        String?  @map("pool_era_id")
  venue            String
  programId        String   @map("program_id")
  poolAddress      String?  @map("pool_address")
  tokenMint        String?  @map("token_mint")
  launchId         String?  @map("launch_id")
  migrationId      String?  @map("migration_id")
  attributionStatus String  @default("RESOLVED") @map("attribution_status")
  signature        String
  instructionIndex Int      @map("instruction_index")
  slot             BigInt
  ts               DateTime
  wallet           String
  direction        String
  baseAmountRaw    String?  @map("base_amount_raw")
  quoteAmountRaw   String?  @map("quote_amount_raw")
  quoteUsd         Decimal? @map("quote_usd") @db.Decimal(20, 6)
  priceUsd         Decimal? @map("price_usd") @db.Decimal(80, 36)
  creatorTrade     Boolean  @default(false) @map("creator_trade")
  rawSnapshot      Json?    @map("raw_snapshot")
  createdAt        DateTime @default(now()) @map("created_at")

  watch SolanaLaunchWatch @relation(fields: [watchId], references: [id], onDelete: Cascade)
  poolEra SolanaPoolEra?   @relation(fields: [poolEraId], references: [id], onDelete: SetNull)

  @@unique([programId, signature, instructionIndex])
  @@index([watchId, ts])
  @@index([poolEraId, ts])
  @@index([poolAddress, ts])
  @@index([tokenMint, ts])
  @@map("solana_swap_observations")
}

// Immutable venue/pool eras belonging to one launch. A migration closes one
// era and starts another; it never makes a mint-only attribution decision.
model SolanaPoolEra {
  id            String   @id @default(cuid())
  watchId       String   @map("watch_id")
  venue         String
  programId     String   @map("program_id")
  poolAddress   String   @map("pool_address")
  quoteMint     String   @map("quote_mint")
  migrationId   String?  @map("migration_id")
  active        Boolean  @default(true)
  startedAt     DateTime @map("started_at")
  endedAt       DateTime? @map("ended_at")
  createdAt     DateTime @default(now()) @map("created_at")

  watch        SolanaLaunchWatch       @relation(fields: [watchId], references: [id], onDelete: Cascade)
  observations SolanaSwapObservation[]

  @@unique([programId, poolAddress])
  @@index([watchId, active])
  @@index([venue, poolAddress, active])
  @@map("solana_pool_eras")
}

// An unresolved trade is valuable research data, but it must never be silently
// assigned to the oldest mint watch. This is append-only attribution telemetry.
model SolanaTradeAttributionIssue {
  id               String   @id @default(cuid())
  chain            String   @default("solana")
  venue            String
  programId        String   @map("program_id")
  poolAddress      String?  @map("pool_address")
  tokenMint        String?  @map("token_mint")
  signature        String
  instructionIndex Int      @map("instruction_index")
  slot             BigInt
  reason           String
  candidateWatchIds Json?   @map("candidate_watch_ids")
  rawSnapshot      Json?    @map("raw_snapshot")
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([programId, signature, instructionIndex])
  @@index([reason, createdAt])
  @@map("solana_trade_attribution_issues")
}

model SolanaExperimentSignal {
  id                     String    @id @default(cuid())
  watchId                String    @map("watch_id")
  strategyVersion        String    @default("solana_multi_launch_flow_v2") @map("strategy_version")
  featureSchemaVersion   String?   @map("feature_schema_version")
  configHash             String    @map("config_hash")
  t0                     DateTime
  t0Slot                 BigInt    @map("t0_slot")
  confirmationDueAt      DateTime  @map("confirmation_due_at")
  horizonAt              DateTime  @map("horizon_at")
  riskCohort             String    @map("risk_cohort")
  benchmarkEligible      Boolean   @default(false) @map("benchmark_eligible")
  status                 String    @default("ACTIVE")
  confirmedAt            DateTime? @map("confirmed_at")
  confirmationSnapshot   Json?     @map("confirmation_snapshot")
  confirmationReject     Json?     @map("confirmation_reject")
  executionSnapshot      Json      @map("execution_snapshot")
  flowSnapshot           Json?     @map("flow_snapshot")
  healthSnapshot         Json      @map("health_snapshot")
  firstEligibleAt        DateTime  @map("first_eligible_at")
  resolvedAt             DateTime? @map("resolved_at")
  resolutionReason       String?   @map("resolution_reason")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  watch SolanaLaunchWatch @relation(fields: [watchId], references: [id], onDelete: Cascade)
  arms  SolanaPaperArm[]

  @@unique([watchId, strategyVersion, configHash])
  @@index([status, confirmationDueAt])
  @@map("solana_experiment_signals")
}

// One immutable baseline per research iteration. It stores provenance only and
// never mutates trading records or recalculates historical fills.
model ResearchIterationSnapshot {
  id                String   @id @default(cuid())
  iteration         String   @unique
  gitCommit         String   @map("git_commit")
  cutoffAt          DateTime @map("cutoff_at")
  strategyVersions  Json     @map("strategy_versions")
  configHashes      Json     @map("config_hashes")
  benchmarkSummary  Json?    @map("benchmark_summary")
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("research_iteration_snapshots")
}

model SolanaPaperArm {
  id                     String    @id @default(cuid())
  signalId               String    @map("signal_id")
  armCode                String    @map("arm_code")
  status                 String    @default("PENDING")
  budgetUsd              Decimal   @default(20) @map("budget_usd") @db.Decimal(12, 4)
  committedUsd           Decimal   @default(0) @map("committed_usd") @db.Decimal(20, 6)
  tokensBoughtRaw        String    @default("0") @map("tokens_bought_raw")
  remainingTokensRaw     String    @default("0") @map("remaining_tokens_raw")
  blendedEntryPriceUsd   Decimal?  @map("blended_entry_price_usd") @db.Decimal(80, 36)
  realizedValueUsd       Decimal   @default(0) @map("realized_value_usd") @db.Decimal(20, 6)
  currentMultiple        Decimal?  @map("current_multiple") @db.Decimal(20, 6)
  maxMultipleObserved    Decimal?  @map("max_multiple_observed") @db.Decimal(20, 6)
  executedRungs          String    @default("") @map("executed_rungs")
  openedAt               DateTime? @map("opened_at")
  closedAt               DateTime? @map("closed_at")
  realizedMultiple       Decimal?  @map("realized_multiple") @db.Decimal(20, 6)
  outcomeClass           String?   @map("outcome_class")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  signal SolanaExperimentSignal @relation(fields: [signalId], references: [id], onDelete: Cascade)
  legs   SolanaExecutionLeg[]

  @@unique([signalId, armCode])
  @@index([status, openedAt])
  @@map("solana_paper_arms")
}

model SolanaExecutionLeg {
  id                String    @id @default(cuid())
  armId             String    @map("arm_id")
  legType           String    @map("leg_type")
  status            String
  idempotencyKey    String    @unique @map("idempotency_key")
  targetExecutionAt DateTime  @map("target_execution_at")
  executedAt        DateTime? @map("executed_at")
  inputUsd          Decimal?  @map("input_usd") @db.Decimal(20, 6)
  outputUsd         Decimal?  @map("output_usd") @db.Decimal(20, 6)
  tokenAmountRaw    String?   @map("token_amount_raw")
  effectivePriceUsd Decimal?  @map("effective_price_usd") @db.Decimal(80, 36)
  slippagePct       Decimal?  @map("slippage_pct") @db.Decimal(10, 6)
  gasUsd            Decimal?  @map("gas_usd") @db.Decimal(12, 6)
  quoteSlot         BigInt?   @map("quote_slot")
  quoteModel        String?   @map("quote_model")
  quoteSnapshot     Json?     @map("quote_snapshot")
  failureReason     String?   @map("failure_reason")
  createdAt         DateTime  @default(now()) @map("created_at")

  arm SolanaPaperArm @relation(fields: [armId], references: [id], onDelete: Cascade)

  @@index([armId, targetExecutionAt])
  @@map("solana_execution_legs")
}

// ─── Shadow gem-tracker (OBSERVATION ONLY — never wired into entry/exit) ─────────
// A survivor that passed the gem-screen hard gate (lp_locked_or_burned + FDV headroom).
model GemCandidate {
  id                String   @id @default(cuid())
  chain             String
  tokenAddress      String   @map("token_address")
  poolAddress       String   @map("pool_address")
  symbol            String?
  liquidityModel    String   @map("liquidity_model")
  deployerAddress   String?  @map("deployer_address")
  t0Ts              DateTime @map("t0_ts") // real discovery time (t0 baseline)
  entryFdvUsd       Decimal? @map("entry_fdv_usd") @db.Decimal(30, 4)
  entryPriceUsd     Decimal? @map("entry_price_usd") @db.Decimal(40, 18)
  entryLiquidityUsd Decimal? @map("entry_liquidity_usd") @db.Decimal(20, 4)
  // LP lock/burn evidence (the hard gate).
  lpLockedOrBurned  Boolean  @map("lp_locked_or_burned")
  lpLockedFraction  Decimal? @map("lp_locked_fraction") @db.Decimal(8, 6)
  lpLockSource      String?  @map("lp_lock_source") // burn | locker:<name> | mixed | undetermined
  screenedAt        DateTime @default(now()) @map("screened_at")

  ticks GemShadowTick[]

  @@unique([chain, tokenAddress, poolAddress])
  @@index([t0Ts])
  @@map("gem_candidates")
}

// One forward observation of a gem_candidate at a horizon bucket. Keyed token+pool+horizon.
model GemShadowTick {
  id            String   @id @default(cuid())
  candidateId   String   @map("candidate_id")
  chain         String
  tokenAddress  String   @map("token_address")
  poolAddress   String   @map("pool_address")
  horizon       String // 15m | 1h | 6h | 24h | 72h
  dueAt         DateTime @map("due_at")
  capturedAt    DateTime @map("captured_at")
  elapsedMin    Int      @map("elapsed_min")
  status        String // captured | missed (started tracking after this horizon passed)
  priceUsd      Decimal? @map("price_usd") @db.Decimal(40, 18)
  fdvUsd        Decimal? @map("fdv_usd") @db.Decimal(30, 4)
  onchainLiqUsd Decimal? @map("onchain_liq_usd") @db.Decimal(20, 4)
  multipleVsT0  Decimal? @map("multiple_vs_t0") @db.Decimal(20, 6) // by FDV
  uniqueBuyers  Int?     @map("unique_buyers")
  uniqueSellers Int?     @map("unique_sellers")
  sellSimOk     Boolean? @map("sell_sim_ok")
  rugFlag       Boolean  @map("rug_flag")
  createdAt     DateTime @default(now()) @map("created_at")

  candidate GemCandidate @relation(fields: [candidateId], references: [id])

  @@unique([candidateId, horizon])
  @@index([chain, tokenAddress, poolAddress])
  @@map("gem_shadow_ticks")
}

// ─── Raw Collector Payloads ────────────────────────────────────────────────────
// Stores the raw API response per pool per cycle.
// Kept separate from pool_snapshots so the normalised time-series table stays lean
// and raw payloads can be pruned/archived on an independent schedule.
model RawCollectorPayload {
  id        String   @id @default(cuid())
  runId     String   @map("run_id")
  chain     String
  source    String // geckoterminal | dexscreener
  ts        DateTime
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([chain, ts])
  @@index([runId])
  @@map("raw_collector_payloads")
}

// ─── Paper Events ──────────────────────────────────────────────────────────────
model PaperEvent {
  id         String   @id @default(cuid())
  positionId String   @map("position_id")
  ts         DateTime
  type       String // BUY | LADDER_SELL | INVALIDATE_SELL | NOT_ENTERED
  price      Decimal  @db.Decimal(80, 36)
  multiple   Decimal? @db.Decimal(16, 4)
  fraction   Decimal? @db.Decimal(8, 6) // fraction of original position transacted
  tokens     Decimal? @db.Decimal(80, 18)
  usd        Decimal? @db.Decimal(20, 4) // net USD (proceeds for sells, cost for buys)
  slipPct    Decimal? @map("slip_pct") @db.Decimal(10, 6)
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")

  position PaperPosition @relation(fields: [positionId], references: [id])

  @@index([positionId])
  @@map("paper_events")
}
